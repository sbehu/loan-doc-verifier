# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets -- never commit real API keys/credentials
.env

# Uploads made through the Streamlit UI during testing
data/documents/_uploads/

# Not needed to run the deployed app -- dataset generation scripts,
# earlier throwaway experiments, and interview-prep scratch notes.
# The eval script and its results are the exception -- README links to
# them directly, so they're tracked even though the rest of
# experiments/ stays ignored.
dataset_creation/
experiments/*
!experiments/08_eval_metrics.py
!experiments/eval_results.json
interview_prep/
